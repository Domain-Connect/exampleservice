{
	"name": "Python 3 + Node.js",
	"image": "mcr.microsoft.com/devcontainers/python:3-3.14-bookworm",
	"features": {
		"ghcr.io/devcontainers/features/github-cli:1": {},
		"ghcr.io/devcontainers/features/docker-in-docker:2": {}
	},
	"customizations": {
		"vscode": {
			"extensions": [
				"Anthropic.claude-code"
			]
		}
	},
	"mounts": [
		"source=claude-code-config-${devcontainerId},target=/home/node/.claude,type=volume"
	],
	"remoteUser": "vscode",
	"containerEnv": {
		"CLAUDE_CONFIG_DIR": "/home/node/.claude"
	},
  	// "forwardPorts": [5016, 5173],
	// Named volumes have no uid/gid mount option and are created root-owned, so
	// re-own the mount on every start to keep it writable for the remote user.
	"postStartCommand": "sudo chown -R vscode:vscode /home/node/.claude",
	"postCreateCommand": "python3 -m venv .venv && .venv/bin/pip install -r requirements.txt"
}
